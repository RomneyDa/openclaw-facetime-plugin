{
  "name": "openclaw-facetime-plugin",
  "version": "0.1.0",
  "description": "macOS FaceTime Audio channel for OpenClaw with ScreenCaptureKit, BlackHole, and realtime voice",
  "type": "module",
  "main": "dist/index.mjs",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/RomneyDa/openclaw-facetime-plugin.git"
  },
  "bugs": {
    "url": "https://github.com/RomneyDa/openclaw-facetime-plugin/issues"
  },
  "homepage": "https://github.com/RomneyDa/openclaw-facetime-plugin#readme",
  "scripts": {
    "build": "npm run build:plugin && npm run build:native",
    "build:plugin": "node scripts/build-plugin.mjs",
    "build:native": "swift build --package-path native -c release && mkdir -p native/bin && cp native/.build/release/openclaw-facetime-bridge native/bin/openclaw-facetime-bridge",
    "test:native": "swift build --package-path native && native/.build/debug/openclaw-facetime-bridge --self-test",
    "prepare": "npm run build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:package": "npm run build && node scripts/verify-package.mjs && node scripts/test-clean-install.mjs",
    "audit:dependencies": "npm audit --omit=dev --audit-level=high",
    "avatar:preview": "npm run build:plugin && node dist/avatar-preview.mjs --demo",
    "avatar:obs-smoke": "npm run build:plugin && node dist/avatar-obs-smoke.mjs",
    "check": "npm run typecheck && npm run build && npm run test:native && npm run test",
    "check:release": "npm run check && npm run test:package && npm run audit:dependencies"
  },
  "engines": {
    "node": ">=22.22.3"
  },
  "os": [
    "darwin"
  ],
  "cpu": [
    "arm64"
  ],
  "keywords": [
    "openclaw",
    "facetime",
    "channel",
    "voice",
    "realtime",
    "screencapturekit",
    "blackhole",
    "macos"
  ],
  "peerDependencies": {
    "openclaw": ">=2026.7.2-beta.1"
  },
  "peerDependenciesMeta": {
    "openclaw": {
      "optional": true
    }
  },
  "dependencies": {
    "@met4citizen/headaudio": "^0.1.0",
    "@met4citizen/talkinghead": "^1.7.0",
    "obs-websocket-js": "^5.0.8",
    "typebox": "^1.3.3",
    "ws": "^8.21.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.15.30",
    "@types/ws": "^8.18.1",
    "esbuild": "^0.25.12",
    "openclaw": "2026.7.2-beta.1",
    "typescript": "^5.8.3",
    "vitest": "^3.2.2"
  },
  "openclaw": {
    "extensions": [
      "./dist/index.mjs"
    ],
    "setupEntry": "./dist/setup-entry.mjs",
    "compat": {
      "pluginApi": ">=2026.7.2-beta.1"
    },
    "channel": {
      "id": "facetime",
      "label": "FaceTime",
      "selectionLabel": "FaceTime Audio (macOS)",
      "blurb": "Answer and place FaceTime Audio calls through a realtime voice agent on this Mac."
    }
  }
}
